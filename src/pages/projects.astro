---
// src/pages/projects.astro — projects index with sector filter (no JS — just visual; filter via hash optional)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection('projects', ({ data }) => data.lang === lang);
const items = all.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const filters = [
  { id: 'all',    label: t('projectsPage.filter.all') },
  { id: 'cement', label: t('projectsPage.filter.cement') },
  { id: 'petro',  label: t('projectsPage.filter.petro') },
  { id: 'food',   label: t('projectsPage.filter.food') },
  { id: 'water',  label: t('projectsPage.filter.water') },
];

const count = (id: string) =>
  id === 'all' ? items.length : items.filter(i => i.data.sector === id).length;
---
<BaseLayout title={t('projectsPage.title').replace(/\n/g, ' ')} description={t('projectsPage.lede')}>
  <PageHero
    coord={lang === 'ar' ? '— المشروعات' : '— PROJECTS'}
    eyebrow={t('projectsPage.eyebrow')}
    title={t('projectsPage.title')}
    lede={t('projectsPage.lede')}
  />

  <section class="projects-body">
    <div class="container-grid">
      <div class="filter-row" role="tablist">
        {filters.map(f => (
          <button class="filter-btn" data-filter={f.id} role="tab" aria-selected={f.id === 'all' ? 'true' : 'false'}>
            {f.label}
            <span class="mono filter-count">{count(f.id)}</span>
          </button>
        ))}
      </div>

      <div class="projects-grid" id="projects-grid">
        {items.map((p, i) => (
          <div class="project-wrap" data-sector={p.data.sector}>
            <ProjectCard
              title={p.data.title}
              summary={p.data.summary}
              sector={p.data.sector}
              year={p.data.year}
              index={i}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-body { background: white; padding: 0 0 120px; }
  .filter-row {
    display: flex; gap: 4px; margin-bottom: 48px;
    border-bottom: 1px solid var(--gray-line);
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 16px 20px; font-size: 14px;
    color: var(--gray-medium); font-weight: 400; background: transparent;
    border: none; border-bottom: 2px solid transparent; margin-bottom: -1px;
    cursor: pointer; transition: color 0.15s;
  }
  .filter-btn[aria-selected="true"] {
    color: var(--navy); font-weight: 600; border-bottom-color: var(--amber);
  }
  .filter-count { margin-inline-start: 8px; font-size: 11px; color: var(--gray-soft); }
  .projects-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .project-wrap.is-hidden { display: none; }
  @media (max-width: 960px) { .projects-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .projects-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    const btns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.project-wrap');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const sel = btn.getAttribute('data-filter');
        btns.forEach(b => b.setAttribute('aria-selected', b === btn ? 'true' : 'false'));
        items.forEach(it => {
          const match = sel === 'all' || it.getAttribute('data-sector') === sel;
          it.classList.toggle('is-hidden', !match);
        });
      });
    });
  })();
</script>
