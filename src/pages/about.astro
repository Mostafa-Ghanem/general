---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import CornerMarks from '../components/ui/CornerMarks.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { milestones, values } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title={t('about.title').replace(/\n/g, ' ')} description={t('about.intro1')}>
  <PageHero coord="— ABOUT" eyebrow={t('about.eyebrow')} title={t('about.title')} />

  <section class="about-lede">
    <div class="container-grid">
      <div class="lede-grid">
        <p class="lede-1">{t('about.intro1')}</p>
        <p class="lede-2">{t('about.intro2')}</p>
      </div>

      <div class="warehouse-visual tech-grid">
        <CornerMarks color="var(--amber)" />
        <span class="mono wh-label">HEAD OFFICE — 10TH OF RAMADAN</span>
        <span class="mono wh-replace">IMG · 001 — REPLACE WITH WAREHOUSE PHOTO</span>
        <svg width="240" height="200" viewBox="0 0 240 200" class="wh-plan">
          <rect x="20" y="20" width="200" height="160" stroke="white" stroke-width="1" fill="none"/>
          <line x1="20" y1="80" x2="220" y2="80" stroke="white" stroke-width="0.5"/>
          <line x1="20" y1="120" x2="220" y2="120" stroke="white" stroke-width="0.5"/>
          <line x1="80" y1="20" x2="80" y2="180" stroke="white" stroke-width="0.5"/>
          <line x1="160" y1="20" x2="160" y2="180" stroke="white" stroke-width="0.5"/>
          <text x="120" y="105" fill="var(--amber)" font-family="IBM Plex Mono" font-size="10" text-anchor="middle" letter-spacing="2">14,000 M²</text>
        </svg>
      </div>
    </div>
  </section>

  <section class="milestones-section">
    <div class="container-grid">
      <SectionLabel coord={lang === 'ar' ? '— الرحلة' : '— TIMELINE'} eyebrow={t('about.milestonesTitle')} />
      <h2 class="display-md milestones-title">{lang === 'ar' ? 'رحلة\nسبعة وعشرين عاماً.' : 'A twenty-seven\nyear journey.'}</h2>
      <div class="milestone-list">
        {milestones[lang].map((m, i) => (
          <div class:list={['milestone', i === milestones[lang].length - 1 && 'is-last']}>
            <span class="mono ms-year">{m.y}</span>
            <h3 class="ms-title">{m.t}</h3>
            <p class="ms-desc">{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="values-section">
    <div class="container-grid">
      <SectionLabel coord={lang === 'ar' ? '— المبادئ' : '— PRINCIPLES'} eyebrow={t('about.valuesTitle')} />
      <h2 class="display-md">{lang === 'ar' ? 'كيف نعمل،\nببساطة.' : 'How we work,\nplainly.'}</h2>
      <div class="values-grid">
        {values[lang].map((v, i) => (
          <div class="value-card">
            <span class="mono val-num">/ {String(i + 1).padStart(2, '0')}</span>
            <h3 class="val-title">{v.t}</h3>
            <p class="val-desc">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .about-lede { background: white; padding: 40px 0 100px; }
  .lede-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
  .lede-1 { margin: 0; font-size: 20px; line-height: 1.6; color: var(--charcoal); }
  .lede-2 { margin: 0; font-size: 17px; line-height: 1.6; color: var(--gray-medium); }
  .warehouse-visual {
    margin-top: 80px; height: 420px; background: var(--navy);
    position: relative; overflow: hidden;
  }
  .wh-label { position: absolute; top: 24px; inset-inline-start: 32px; font-size: 11px; color: rgba(255,255,255,0.6); letter-spacing: 0.14em; }
  .wh-replace { position: absolute; bottom: 24px; inset-inline-end: 32px; font-size: 10px; color: var(--amber); letter-spacing: 0.14em; }
  .wh-plan { position: absolute; inset: 0; margin: auto; opacity: 0.5; }

  .milestones-section { background: var(--gray-light); padding: 120px 0; }
  .milestones-title { margin: 0; white-space: pre-line; text-wrap: balance; }
  .milestone-list { margin-top: 64px; }
  .milestone {
    display: grid; grid-template-columns: 140px 1fr 2fr; gap: 40px;
    padding: 32px 0; border-top: 1px solid var(--gray-line);
    align-items: start;
  }
  .milestone.is-last { border-bottom: 1px solid var(--gray-line); }
  .ms-year { font-size: 18px; font-weight: 600; color: var(--amber); letter-spacing: 0.06em; }
  .ms-title { margin: 0; font-size: 22px; font-weight: 600; color: var(--charcoal); }
  .ms-desc { margin: 0; font-size: 16px; line-height: 1.6; color: var(--gray-medium); }

  .values-section { background: white; padding: 120px 0; }
  .values-grid { margin-top: 56px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .value-card {
    padding: 40px 32px; border: 1px solid var(--gray-line); background: white;
  }
  .value-card + .value-card { margin-inline-start: -1px; }
  .val-num { font-size: 11px; color: var(--amber); letter-spacing: 0.14em; font-weight: 500; }
  .val-title { margin: 20px 0 14px; font-size: 22px; font-weight: 600; color: var(--charcoal); }
  .val-desc { margin: 0; font-size: 15px; line-height: 1.6; color: var(--gray-medium); }

  @media (max-width: 800px) {
    .lede-grid { grid-template-columns: 1fr; gap: 24px; }
    .milestone { grid-template-columns: 1fr; gap: 8px; }
    .values-grid { grid-template-columns: 1fr; }
    .value-card + .value-card { margin-inline-start: 0; margin-top: -1px; }
  }
</style>
