---
// src/pages/services/index.astro — Products index (EN)
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ProductGrid from '../../components/sections/ProductGrid.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title={t('nav.products')} description={t('products.lede')}>
  <PageHero
    coord={lang === 'ar' ? '— الكتالوج' : '— CATALOG'}
    eyebrow={t('products.eyebrow')}
    title={t('products.title')}
    lede={t('products.lede')}
  />
  <ProductGrid withHeader={false} />

  <section class="cat-stats-section">
    <div class="container-grid">
      <div class="cat-stats">
        <div class="stat">
          <div class="stat-v">{lang === 'ar' ? '٩,٥٠٠+' : '9,500+'}</div>
          <div class="mono stat-l">{lang === 'ar' ? 'كود منتج' : 'SKUs in stock'}</div>
        </div>
        <div class="stat">
          <div class="stat-v">24"</div>
          <div class="mono stat-l">{lang === 'ar' ? 'أكبر قطر متوفر' : 'Largest diameter'}</div>
        </div>
        <div class="stat">
          <div class="stat-v mono">ASTM·DIN·BS</div>
          <div class="mono stat-l">{lang === 'ar' ? 'معايير معتمدة' : 'Standards'}</div>
        </div>
        <div class="stat">
          <div class="stat-v">{lang === 'ar' ? '٢٤ ساعة' : '24 hr'}</div>
          <div class="mono stat-l">{lang === 'ar' ? 'تجهيز الطلب' : 'Order ready in'}</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-stats-section { background: white; padding: 0 0 120px; }
  .cat-stats {
    padding: 40px 0; border-top: 1px solid var(--gray-line); border-bottom: 1px solid var(--gray-line);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px;
  }
  .stat-v { font-size: 28px; font-weight: 600; color: var(--navy); letter-spacing: -0.01em; }
  .stat-l { margin-top: 8px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray-medium); }
  @media (max-width: 640px) { .cat-stats { grid-template-columns: 1fr 1fr; } }
</style>
