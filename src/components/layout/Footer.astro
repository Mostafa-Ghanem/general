---
// src/components/layout/Footer.astro
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { productSlugs, productInfo } from '../../i18n/ui';
import Logo from '../ui/Logo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems: Array<{ key: 'home' | 'about' | 'services' | 'projects' | 'contact'; label: string }> = [
  { key: 'home',     label: t('nav.home') },
  { key: 'about',    label: t('nav.about') },
  { key: 'services', label: t('nav.products') },
  { key: 'projects', label: t('nav.projects') },
  { key: 'contact',  label: t('nav.contact') },
];

const productLinks = productSlugs.slice(0, 6).map(s => ({
  slug: s,
  name: productInfo[s][lang].name,
}));
---
<footer class="site-footer">
  <div class="container-grid">
    <div class="footer-grid">
      <div>
        <Logo />
        <p class="footer-blurb">
          {lang === 'ar'
            ? 'مورد متخصص في مهمات المصانع لقطاعات البتروكيماويات، الإسمنت، الأغذية، والمياه منذ ١٩٩٨.'
            : 'Specialist supplier of industrial equipment to petrochemicals, cement, food and water utilities since 1998.'}
        </p>
        <div class="footer-actions">
          <a href="https://wa.me/201016265762" class="btn btn-outline-light" style="padding:10px 16px;font-size:13px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.5 12a8.5 8.5 0 0 1-12.7 7.4L3.5 21l1.6-4.2A8.5 8.5 0 1 1 20.5 12z"/></svg>
            {t('cta.whatsapp')}
          </a>
          <a href="tel:+201016265762" class="btn btn-outline-light" style="padding:10px 16px;font-size:13px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 3h4l2 5-3 2c1 2 3 4 5 5l2-3 5 2v4c0 1-1 2-2 2C9 20 4 15 4 5c0-1 1-2 1-2z"/></svg>
            {t('cta.callNow')}
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="mono footer-col-title">{t('footer.navTitle')}</h4>
        {navItems.map(it => (
          <a href={getLocalizedPath(it.key, lang)} class="footer-link">{it.label}</a>
        ))}
      </div>

      <div class="footer-col">
        <h4 class="mono footer-col-title">{t('footer.productsTitle')}</h4>
        {productLinks.map(p => (
          <a href={getLocalizedPath('services', lang, p.slug)} class="footer-link">{p.name}</a>
        ))}
        <a href={getLocalizedPath('services', lang)} class="footer-link" style="color: var(--amber);">
          {t('cta.viewAll')} →
        </a>
      </div>

      <div class="footer-col">
        <h4 class="mono footer-col-title">{t('footer.contactTitle')}</h4>
        <div class="footer-line mono">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
          <span>{t('footer.address')}</span>
        </div>
        <div class="footer-line mono">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 3h4l2 5-3 2c1 2 3 4 5 5l2-3 5 2v4c0 1-1 2-2 2C9 20 4 15 4 5c0-1 1-2 1-2z"/></svg>
          <span>{t('footer.phone')}</span>
        </div>
        <div class="footer-line mono latin">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14"/><polyline points="3,5 12,13 21,5"/></svg>
          <span>{t('footer.email')}</span>
        </div>
        <div class="footer-line mono">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{t('footer.hours')}</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="mono">{t('footer.rights')}</span>
      <span class="mono">ISO 9001 · ASTM · DIN · BS</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-deep); color: rgba(255,255,255,0.7); padding-top: 80px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 48px; }
  .footer-blurb { margin-top: 20px; line-height: 1.6; color: rgba(255,255,255,0.55); max-width: 320px; }
  .footer-actions { margin-top: 24px; display: flex; gap: 12px; }
  .footer-col-title {
    margin: 0 0 18px; font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--amber); font-weight: 500;
  }
  .footer-link {
    display: block; font-size: 14px; color: rgba(255,255,255,0.6);
    padding: 6px 0; transition: color 0.15s;
  }
  .footer-link:hover { color: var(--amber); }
  .footer-line {
    display: flex; align-items: flex-start; gap: 10px; padding: 6px 0;
    color: rgba(255,255,255,0.55); font-size: 13px;
  }
  .footer-line svg { flex-shrink: 0; margin-top: 2px; }
  .footer-bottom {
    margin-top: 64px; padding: 24px 0 32px;
    border-top: 1px solid rgba(255,255,255,0.1);
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 16px; color: rgba(255,255,255,0.45); font-size: 12px;
  }
  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
