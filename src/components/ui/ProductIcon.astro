---
// src/components/ui/ProductIcon.astro — technical line icon per product slug
import type { ProductSlug } from '../../i18n/ui';

interface Props {
  slug: ProductSlug;
  size?: number;
}
const { slug, size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
  {slug === 'flanges' && (<>
    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/>
    <circle cx="12" cy="3.5" r="1"/><circle cx="12" cy="20.5" r="1"/>
    <circle cx="3.5" cy="12" r="1"/><circle cx="20.5" cy="12" r="1"/>
    <circle cx="6" cy="6" r="1"/><circle cx="18" cy="6" r="1"/>
    <circle cx="6" cy="18" r="1"/><circle cx="18" cy="18" r="1"/>
  </>)}
  {slug === 'pipes' && (<>
    <rect x="2" y="8" width="20" height="8"/>
    <line x1="2" y1="10" x2="22" y2="10"/><line x1="2" y1="14" x2="22" y2="14"/>
  </>)}
  {slug === 'plates' && (<>
    <rect x="3" y="3" width="14" height="14"/>
    <rect x="7" y="7" width="14" height="14"/>
  </>)}
  {slug === 'tees' && (<path d="M3 9h18v6H15v6H9v-6H3z"/>)}
  {slug === 'hydraulic' && (<>
    <rect x="3" y="9" width="14" height="6"/>
    <rect x="17" y="7" width="4" height="10"/>
    <line x1="11" y1="5" x2="11" y2="9"/>
    <line x1="9" y1="5" x2="13" y2="5"/>
  </>)}
  {slug === 'valves' && (<>
    <circle cx="12" cy="12" r="5"/>
    <line x1="2" y1="12" x2="7" y2="12"/><line x1="17" y1="12" x2="22" y2="12"/>
    <line x1="12" y1="2" x2="12" y2="7"/><line x1="8" y1="2" x2="16" y2="2"/>
  </>)}
  {slug === 'flex' && (<>
    <path d="M2 12c2-3 4 3 6 0s4 3 6 0 4 3 6 0"/>
    <line x1="2" y1="6" x2="2" y2="18"/><line x1="22" y1="6" x2="22" y2="18"/>
  </>)}
  {slug === 'gaskets' && (<>
    <circle cx="12" cy="12" r="9"/>
    <circle cx="12" cy="12" r="5"/>
    <circle cx="12" cy="12" r="7" stroke-dasharray="2 2"/>
  </>)}
  {slug === 'fasteners' && (<>
    <polygon points="6,4 18,4 21,8 18,20 6,20 3,8"/>
    <line x1="6" y1="8" x2="18" y2="8"/>
    <line x1="9" y1="11" x2="15" y2="11"/>
    <line x1="9" y1="14" x2="15" y2="14"/>
    <line x1="9" y1="17" x2="15" y2="17"/>
  </>)}
</svg>
