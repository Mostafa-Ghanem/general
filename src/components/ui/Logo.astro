---
// src/components/ui/Logo.astro
import { getLangFromUrl } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const longName = lang === 'ar' ? 'العامة لمهمات المصانع' : 'General Factory Equipment';
---
<div class="logo">
  <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <rect x="0.5" y="0.5" width="39" height="39" fill="var(--navy-deep)" stroke="rgba(255,255,255,0.2)" />
    <circle cx="20" cy="20" r="10" stroke="white" stroke-width="1.5" fill="none" />
    <circle cx="20" cy="20" r="4.5" stroke="var(--amber)" stroke-width="1.5" fill="none" />
    <circle cx="20" cy="9" r="1.2" fill="white" />
    <circle cx="20" cy="31" r="1.2" fill="white" />
    <circle cx="9" cy="20" r="1.2" fill="white" />
    <circle cx="31" cy="20" r="1.2" fill="white" />
  </svg>
  <div class="logo-text">
    <span class="logo-name">{longName}</span>
    <span class="mono logo-est">EST. 1998 — CAIRO</span>
  </div>
</div>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo-name { font-size: 16px; font-weight: 600; color: white; }
  .logo-est { font-size: 10px; letter-spacing: 0.14em; color: var(--amber); margin-top: 2px; }
</style>
