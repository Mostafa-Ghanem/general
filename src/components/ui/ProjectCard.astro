---
// src/components/ui/ProjectCard.astro
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  title: string;
  summary: string;
  sector: 'cement' | 'petro' | 'food' | 'water' | 'power' | 'pharma';
  year: string;
  index: number;
}
const { title, summary, sector, year, index } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const sectorLabel: Record<string, { ar: string; en: string }> = {
  cement: { ar: 'إسمنت',      en: 'Cement' },
  petro:  { ar: 'بترول وغاز', en: 'Oil & Gas' },
  food:   { ar: 'أغذية',      en: 'Food' },
  water:  { ar: 'مياه',       en: 'Water' },
  power:  { ar: 'طاقة',       en: 'Power' },
  pharma: { ar: 'أدوية',      en: 'Pharma' },
};
---
<article class="project-card card-hover">
  <div class="placeholder-img" style="aspect-ratio: 4/3;">
    <span class="ph-label">PROJECT {String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="pj-body">
    <div class="pj-meta">
      <span class="mono pj-sector">{sectorLabel[sector][lang]}</span>
      <span class="mono pj-year">{year}</span>
    </div>
    <h3 class="pj-title">{title}</h3>
    <p class="pj-summary">{summary}</p>
  </div>
</article>

<style>
  .project-card {
    background: white; border: 1px solid var(--gray-line);
    display: flex; flex-direction: column; height: 100%;
  }
  .pj-body { padding: 24px; }
  .pj-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .pj-sector { font-size: 11px; color: var(--gray-medium); letter-spacing: 0.12em; text-transform: uppercase; }
  .pj-year { font-size: 11px; color: var(--gray-soft); }
  .pj-title { margin: 0; font-size: 19px; font-weight: 600; color: var(--charcoal); line-height: 1.3; }
  .pj-summary { margin: 10px 0 0; font-size: 14px; line-height: 1.55; color: var(--gray-medium); }
</style>
