---
// src/components/sections/ContactCTA.astro
import { getLangFromUrl, useTranslations, getLocalizedPath, WHATSAPP_URL, PHONE_TEL } from '../../i18n/utils';
import SectionLabel from '../ui/SectionLabel.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contactHref = getLocalizedPath('contact', lang);
---
<section class="cta-section tech-grid">
  <div class="container-grid">
    <div class="cta-grid">
      <div>
        <SectionLabel coord={lang === 'ar' ? '٠٥ — تواصل' : '05 — CONTACT'} eyebrow={t('contactCta.eyebrow')} dark />
        <h2 class="display-md cta-title">{t('contactCta.title')}</h2>
        <p class="cta-lede">{t('contactCta.lede')}</p>
      </div>
      <div class="cta-actions">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-primary cta-btn">
          <span class="cta-btn-l">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.5 12a8.5 8.5 0 0 1-12.7 7.4L3.5 21l1.6-4.2A8.5 8.5 0 1 1 20.5 12z"/></svg>
            {t('cta.whatsapp')}
          </span>
          <span class="mono cta-btn-r">+20 10 1626 5762</span>
        </a>
        <a href={PHONE_TEL} class="btn btn-outline-light cta-btn">
          <span class="cta-btn-l">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 3h4l2 5-3 2c1 2 3 4 5 5l2-3 5 2v4c0 1-1 2-2 2C9 20 4 15 4 5c0-1 1-2 1-2z"/></svg>
            {t('cta.callNow')}
          </span>
          <span class="mono cta-btn-r">{t('footer.phone')}</span>
        </a>
        <a href={contactHref} class="cta-ghost">
          {lang === 'ar' ? 'كل وسائل التواصل' : 'All contact options'}
          {lang === 'ar' ? ' ←' : ' →'}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { background: var(--navy-deep); color: white; padding: 100px 0; }
  .cta-grid { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .cta-title { margin: 0; color: white; white-space: pre-line; text-wrap: balance; }
  .cta-lede { margin-top: 24px; font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.7); max-width: 540px; }
  .cta-actions { display: flex; flex-direction: column; gap: 12px; min-width: 280px; }
  .cta-btn { justify-content: space-between; padding: 18px 24px; font-size: 16px; }
  .cta-btn-l { display: flex; align-items: center; gap: 10px; }
  .cta-btn-r { font-size: 13px; }
  .cta-ghost {
    color: rgba(255,255,255,0.7); padding: 12px 0;
    font-size: 14px; font-weight: 500;
  }
  @media (max-width: 880px) {
    .cta-grid { grid-template-columns: 1fr; }
    .cta-actions { min-width: 0; width: 100%; }
  }
</style>
