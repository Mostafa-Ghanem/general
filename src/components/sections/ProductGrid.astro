---
// src/components/sections/ProductGrid.astro
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { productSlugs } from '../../i18n/ui';
import SectionLabel from '../ui/SectionLabel.astro';
import ProductCard from '../ui/ProductCard.astro';

interface Props {
  withHeader?: boolean;
}
const { withHeader = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="product-grid-section">
  <div class="container-grid">
    {withHeader && (
      <div class="pg-head">
        <div>
          <SectionLabel coord={lang === 'ar' ? '٠٢ — الكتالوج' : '02 — CATALOG'} eyebrow={t('products.eyebrow')} />
          <h2 class="display-lg pg-title">{t('products.title')}</h2>
        </div>
        <p class="pg-lede">{t('products.lede')}</p>
      </div>
    )}

    <div class="pg-grid">
      {productSlugs.map((slug, i) => (
        <div class={`pg-cell ${i % 3 !== 0 ? 'has-x' : ''} ${i >= 3 ? 'has-y' : ''}`}>
          <ProductCard slug={slug} index={i} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .product-grid-section { padding: 120px 0; background: white; }
  .pg-head { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: end; margin-bottom: 64px; }
  .pg-title { margin: 0; white-space: pre-line; text-wrap: balance; }
  .pg-lede { margin: 0; font-size: 17px; line-height: 1.6; color: var(--gray-medium); max-width: 460px; justify-self: end; }
  html[dir="rtl"] .pg-lede { justify-self: start; }
  .pg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .pg-cell.has-x { border-inline-start: 1px solid var(--gray-line); }
  .pg-cell.has-y { border-top: 1px solid var(--gray-line); }
  .pg-cell :global(.product-card) { border: none; width: 100%; height: 100%; }

  @media (max-width: 960px) {
    .pg-head { grid-template-columns: 1fr; gap: 32px; }
    .pg-grid { grid-template-columns: 1fr 1fr; }
    .pg-cell { border: none; }
    .pg-cell:nth-child(2n) { border-inline-start: 1px solid var(--gray-line); }
    .pg-cell:nth-child(n+3) { border-top: 1px solid var(--gray-line); }
  }
  @media (max-width: 640px) {
    .pg-grid { grid-template-columns: 1fr; }
    .pg-cell { border: none !important; }
    .pg-cell:nth-child(n+2) { border-top: 1px solid var(--gray-line) !important; }
  }
</style>
