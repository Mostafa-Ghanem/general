---
// src/components/sections/Hero.astro — homepage hero
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import SectionLabel from '../ui/SectionLabel.astro';
import CornerMarks from '../ui/CornerMarks.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const products = getLocalizedPath('services', lang);
const contact = getLocalizedPath('contact', lang);

const metrics = [
  { v: t('hero.metric.years.v'),    l: t('hero.metric.years.l') },
  { v: t('hero.metric.clients.v'),  l: t('hero.metric.clients.l') },
  { v: t('hero.metric.sku.v'),      l: t('hero.metric.sku.l') },
  { v: t('hero.metric.delivery.v'), l: t('hero.metric.delivery.l') },
];
---
<section class="hero tech-grid">
  <CornerMarks color="rgba(255,255,255,0.18)" />

  <span class="mono hero-coord">{lang === 'ar' ? '٠١ — الرئيسية' : '01 — HOME'}</span>

  <div class="container-grid hero-content">
    <div class="hero-grid">
      <div>
        <SectionLabel coord={lang === 'ar' ? '— مقدمة' : '— INTRO'} eyebrow={t('hero.eyebrow')} dark />
        <h1 class="display-xl hero-title">{t('hero.title')}</h1>
        <p class="hero-lede">{t('hero.lede')}</p>
        <div class="hero-actions">
          <a href={products} class="btn btn-primary">
            {t('hero.primary')}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              {lang === 'ar' ? <><line x1="4" y1="12" x2="20" y2="12"/><polyline points="10 6 4 12 10 18"/></> : <><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></>}
            </svg>
          </a>
          <a href={contact} class="btn btn-outline-light">{t('hero.secondary')}</a>
        </div>
      </div>

      <div class="hero-visual">
        <svg viewBox="0 0 320 400" width="100%" height="100%">
          <defs>
            <pattern id="hdots" width="14" height="14" patternUnits="userSpaceOnUse">
              <circle cx="1" cy="1" r="0.8" fill="rgba(255,255,255,0.15)"/>
            </pattern>
          </defs>
          <rect x="20" y="20" width="280" height="360" fill="url(#hdots)" stroke="rgba(255,255,255,0.12)"/>
          <g stroke="var(--amber)" stroke-width="1.5" fill="none">
            <path d="M20 28 L20 20 L28 20"/>
            <path d="M300 20 L300 28 M300 20 L292 20"/>
            <path d="M20 372 L20 380 L28 380"/>
            <path d="M300 380 L292 380 M300 380 L300 372"/>
          </g>
          <g transform="translate(160,180)" stroke="white" fill="none">
            <circle r="90" stroke-width="1.5"/>
            <circle r="60" stroke-width="1"/>
            <circle r="35" stroke-width="1.5" fill="var(--navy-deep)"/>
            <circle r="12" stroke-width="1.5"/>
            <circle cx="0" cy="-75" r="4" stroke-width="1.2"/>
            <circle cx="53" cy="-53" r="4" stroke-width="1.2"/>
            <circle cx="75" cy="0" r="4" stroke-width="1.2"/>
            <circle cx="53" cy="53" r="4" stroke-width="1.2"/>
            <circle cx="0" cy="75" r="4" stroke-width="1.2"/>
            <circle cx="-53" cy="53" r="4" stroke-width="1.2"/>
            <circle cx="-75" cy="0" r="4" stroke-width="1.2"/>
            <circle cx="-53" cy="-53" r="4" stroke-width="1.2"/>
            <line x1="-90" y1="-115" x2="90" y2="-115" stroke="var(--amber)" stroke-width="1"/>
            <line x1="-90" y1="-110" x2="-90" y2="-120" stroke="var(--amber)" stroke-width="1"/>
            <line x1="90" y1="-110" x2="90" y2="-120" stroke="var(--amber)" stroke-width="1"/>
          </g>
          <text x="160" y="55" fill="var(--amber)" font-family="IBM Plex Mono" font-size="11" text-anchor="middle" letter-spacing="2">Ø 180 mm</text>
          <text x="160" y="335" fill="white" font-family="IBM Plex Mono" font-size="11" text-anchor="middle" letter-spacing="3" opacity="0.7">ASTM A105 / WN-150#</text>
          <text x="160" y="355" fill="rgba(255,255,255,0.4)" font-family="IBM Plex Mono" font-size="9" text-anchor="middle" letter-spacing="2">DWG · 001 — FLG · WN</text>
        </svg>
      </div>
    </div>

    <div class="metrics">
      {metrics.map((m, i) => (
        <div class:list={['metric-cell', i > 0 && 'has-border']}>
          <div class="metric-v">{m.v}</div>
          <div class="mono metric-l">{m.l}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; background: var(--navy); color: white;
    overflow: hidden; padding: 80px 0;
  }
  .hero-coord {
    position: absolute; top: 24px;
    inset-inline-end: 32px;
    font-size: 11px; letter-spacing: 0.16em;
    color: rgba(255,255,255,0.4);
  }
  .hero-content { position: relative; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 80px; align-items: center; }
  .hero-title { margin: 0; color: white; white-space: pre-line; text-wrap: balance; }
  .hero-lede { margin-top: 28px; font-size: 18px; line-height: 1.55; color: rgba(255,255,255,0.7); max-width: 540px; }
  .hero-actions { margin-top: 36px; display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-visual { position: relative; aspect-ratio: 4/5; }

  .metrics {
    margin-top: 96px; border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 40px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
  }
  .metric-cell { padding: 0 32px; }
  .metric-cell.has-border { border-inline-start: 1px solid rgba(255,255,255,0.12); }
  .metric-v { font-size: clamp(36px, 4vw, 56px); font-weight: 600; line-height: 1; color: white; letter-spacing: -0.02em; }
  .metric-l { margin-top: 14px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.55); }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 56px; }
    .hero-visual { max-width: 360px; margin: 0 auto; }
    .metrics { grid-template-columns: 1fr 1fr; gap: 32px 0; }
    .metric-cell:nth-child(3), .metric-cell:nth-child(4) {
      padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.12);
    }
    .metric-cell:nth-child(3) { border-inline-start: none !important; }
  }
</style>
